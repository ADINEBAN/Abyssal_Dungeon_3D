      "graphicsPresetTier": "High",
      "particleDensityMultiplier": 1.00,
      "maxParticlesPerEffect": 72,
      "maxActiveScenePointLights": 12,
      "dynamicLightOnVfx": true,
      "allowDistortionPass": true,
      "allowSecondaryDebris": true,
      "allowFootstepDust": true,
      "keepCombatTelegraphsFull": true,
